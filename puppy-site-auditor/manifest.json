{
  "manifest_version": 3,
  "name": "Puppy Site Auditor",
  "version": "0.1.0",
  "description": "Audit a URL list for dog-related content with live progress, manual override, stop/pause, and CSV export.",
  "permissions": ["tabs", "storage", "sidePanel", "scripting", "downloads"],
  "host_permissions": ["<all_urls>"],
  "background": {"service_worker": "background.js"},
  "side_panel": {"default_path": "sidepanel/index.html"},
  "action": {"default_title": "Puppy Site Auditor"},
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["assets/ort.min.js", "content/analyzer.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["assets/dog-model.onnx", "assets/ort-wasm.wasm", "assets/ort-wasm-simd.wasm"],
    "matches": ["<all_urls>"]
  }]
}
