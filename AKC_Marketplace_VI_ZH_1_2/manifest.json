{
  "manifest_version": 3,
  "name": "AKC Marketplace · VI/ZH · Paced",
  "version": "1.5.0",
  "description": "AKC Marketplace collector with Vietnamese and Chinese interface",
  "permissions": [
    "scripting",
    "storage",
    "downloads",
    "alarms",
    "webRequest"
  ],
  "host_permissions": [
    "https://marketplace.akc.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AKC Marketplace · VI/ZH"
  }
}
