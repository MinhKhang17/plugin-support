{
  "manifest_version": 3,
  "name": "Google Maps Collector - Cào dữ liệu theo khu vực",
  "version": "2.0.0",
  "description": "Tìm kiếm và thu thập dữ liệu Google Maps theo nhiều khu vực, nhập CSV và xuất CSV tổng hợp hoặc theo khu vực.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://www.google.com/maps/*"
  ],
  "action": {
    "default_title": "Google Maps Collector",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/maps/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
